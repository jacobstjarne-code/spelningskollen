# Ticketmaster Discovery API
# Registrera på https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your_key_here

# Songkick API (valfritt)
# Registrera på https://www.songkick.com/developer
SONGKICK_API_KEY=your_key_here

# Spotify API — för artist-enrichment (genre, popularitet, relaterade artister)
# Registrera på https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Anthropic API — för Claude genre-klassificering (fallback om Spotify saknar genre)
ANTHROPIC_API_KEY=your_key_here
